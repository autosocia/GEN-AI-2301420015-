   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "data = np.random.normal(0, 1, 1000)\n",
    "transformed = np.exp(data)\n",
    "\n",
    "plt.subplot(1,2,1)\n",
    "sns.histplot(data, kde=True)\n",
    "\n",
    "plt.subplot(1,2,2)\n",
    "sns.histplot(transformed, kde=True, color=\"purple\")\n",
    "\n",
    "plt.show()"
   ]
  }
 ],
