   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "data=np.cumsum(np.random.randn(100))\n",
    "\n",
    "pred=[]\n",
    "\n",
    "for i in range(1,len(data)):\n",
    "    pred.append(np.mean(data[:i]))\n",
    "\n",
    "plt.plot(data,label=\"Actual\")\n",
    "plt.plot(range(1,len(data)),pred,label=\"Predicted\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  }
 ],
